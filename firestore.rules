rules_version = '2';

/* ------------------------------------------------------------------ *
 * Chạm HQ security rules.
 *
 * The short version:
 *   - Only people listed in /members can read anything at all.
 *   - Only admins (Peter, Bach) can create, delete or reassign a task.
 *   - A member can change the status and note of THEIR OWN tasks only,
 *     and cannot touch the title, the due date or who it belongs to.
 *
 * Members are keyed by lowercase email, so an admin can add somebody
 * before that person has ever signed in.
 * ------------------------------------------------------------------ */
service cloud.firestore {
  match /databases/{database}/documents {

    function email()     { return request.auth.token.email.lower(); }
    function memberRef() { return /databases/$(database)/documents/members/$(email()); }
    function isMember()  { return request.auth != null && exists(memberRef()); }
    function me()        { return get(memberRef()).data; }
    // .get with a default: a member document with no 'admin' field simply
    // is not an admin, rather than erroring out mid-rule.
    function isAdmin()   { return isMember() && me().get('admin', false) == true; }

    match /members/{memberEmail} {
      allow read:  if isMember();
      allow write: if isAdmin();
    }

    // The day-by-day feed. Everyone reads it. Members may post their own
    // progress under their own name; admins may post as anyone and tidy up.
    match /updates/{updateId} {
      allow read:   if isMember();
      allow create: if isAdmin()
                    || (isMember() && request.resource.data.who == me().personKey);
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isMember() && resource.data.who == me().personKey);
    }

    // Photos for CAS evidence. Stored small and inline, readable only by
    // members - these are pictures of students and must not be public.
    match /photos/{photoId} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.who == me().personKey
                    && request.resource.data.data.size() < 1000000;
      allow update: if false;
      allow delete: if isAdmin()
                    || (isMember() && resource.data.who == me().personKey);
    }

    match /tasks/{taskId} {
      allow read:            if isMember();
      allow create, delete:  if isAdmin();

      allow update: if isAdmin()
        || (
             isMember()
             // it must be your own task, and it must stay yours
             && resource.data.who == me().personKey
             && request.resource.data.who == resource.data.who
             // you may only move these fields, nothing else
             && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['status', 'note', 'progress', 'doneAt', 'updatedAt'])
             && request.resource.data.status in ['open', 'doing', 'blocked', 'done']
           );
    }
  }
}
