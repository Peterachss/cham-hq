rules_version = '2';

/* ------------------------------------------------------------------ *
 * Chạm HQ security rules.
 *
 * The short version:
 *   - Only people listed in /members can read anything at all.
 *   - Only admins (Peter, Bach) can create, delete or reassign a task.
 *   - A member can change the status and note of THEIR OWN tasks only,
 *     and cannot touch the title, the due date or who it belongs to.
 *
 * Members are keyed by lowercase email, so an admin can add somebody
 * before that person has ever signed in.
 * ------------------------------------------------------------------ */
service cloud.firestore {
  match /databases/{database}/documents {

    function email()     { return request.auth.token.email.lower(); }
    function memberRef() { return /databases/$(database)/documents/members/$(email()); }
    function isMember()  { return request.auth != null && exists(memberRef()); }
    function me()        { return get(memberRef()).data; }
    // .get with a default: a member document with no 'admin' field simply
    // is not an admin, rather than erroring out mid-rule.
    function isAdmin()   { return isMember() && me().get('admin', false) == true; }
    // Thuan, or whoever holds the money. Set finance: true on their member doc.
    function isFinance() { return isMember() && me().get('finance', false) == true; }
    // Whoever runs the background jobs (Peter). Set sysadmin: true on their member doc.
    function isSysadmin() { return isMember() && me().get('sysadmin', false) == true; }

    match /members/{memberEmail} {
      allow read:  if isMember();
      allow write: if isAdmin();
    }

    // The day-by-day feed. Everyone reads it. Members may post their own
    // progress under their own name; admins may post as anyone and tidy up.
    match /updates/{updateId} {
      allow read:   if isMember();
      allow create: if isAdmin()
                    || (isMember() && request.resource.data.who == me().personKey);
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isMember() && resource.data.who == me().personKey);
    }

    // Photos for CAS evidence. Stored small and inline, readable only by
    // members - these are pictures of students and must not be public.
    match /photos/{photoId} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.who == me().personKey
                    && request.resource.data.data.size() < 1000000;
      allow update: if false;
      allow delete: if isAdmin()
                    || (isMember() && resource.data.who == me().personKey);
    }

    // Money in and out. Anybody can log a line under their own name; only
    // finance and the admins can mark it as in the sheet, paid back, or
    // change it afterwards. You may delete your own line until finance has
    // dealt with it.
    match /expenses/{expenseId} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.createdBy == email()
                    && request.resource.data.kind in ['in', 'out']
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.amount < 1000000000
                    && request.resource.data.status == 'new'
                    && request.resource.data.get('receipt', '').size() < 900000;
      allow update: if isAdmin() || isFinance();
      allow delete: if isAdmin() || isFinance()
                    || (isMember()
                        && resource.data.createdBy == email()
                        && resource.data.status == 'new');
    }

    // A device's push subscription. You can only file one under your own
    // email. Nobody reads them from the site: only the sender does, and it
    // runs with the service account, which the rules do not apply to.
    match /pushSubs/{subId} {
      allow create, update: if isMember()
                            && request.resource.data.email == email()
                            && request.resource.data.endpoint is string
                            && request.resource.data.endpoint.matches('https://.+');
      allow delete: if isMember() && resource.data.email == email();
      allow read:   if false;
    }

    // Tonight's chat wrap, waiting for Peter or Bach to look before it
    // goes anywhere. Written only by the nightly job (service account).
    match /chatDrafts/{day} {
      allow read, update, delete: if isAdmin();
      allow create:               if false;
    }

    // The short version of tonight's wrap, for the Instagram group chat.
    // An admin approving the wrap files it as "pending" (one per night);
    // the sender on the computer with the Instagram bot posts it and marks
    // it sent. Admins may cancel one still waiting, or try a failed one
    // again - never mark one sent or edit what it says.
    match /outbox/{msgId} {
      function m() { return request.resource.data; }
      allow read:   if isMember();
      allow create: if isAdmin()
                    && m().keys().hasOnly(['kind', 'date', 'text', 'by', 'byName', 'createdBy', 'status', 'createdAt'])
                    && m().kind == 'nightly'
                    && m().date is string
                    && msgId == 'nightly-' + m().date
                    && m().status == 'pending'
                    && m().by == me().personKey
                    && m().createdBy == email()
                    && m().text is string && m().text.size() > 0 && m().text.size() <= 1000
                    && m().createdAt == request.time;
      allow update: if isAdmin()
                    && m().diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy'])
                    && ((resource.data.status == 'pending' && m().status == 'cancelled')
                     || (resource.data.status == 'failed' && m().status == 'pending'));
      allow delete: if false;
    }

    // Simple asks spotted in the chat by the nightly wrap ("move the sale
    // to the 7th"), each with the change it proposes. Written only by the
    // wrap (service account). Admins apply or dismiss them - applying makes
    // the real change through the usual rules for jobs and events.
    match /requests/{reqId} {
      allow read:   if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['applied', 'dismissed'];
      allow create, delete: if false;
    }

    // The Announce box, and Nudge on a job. Admins file a message under
    // their own name as "pending"; the sender (service account) pushes it -
    // to everyone, or for a nudge (with "to") to that one person - and marks
    // it sent. Nobody on the site can edit one or pretend it was sent.
    // Any member may also send a "test" to their own devices only.
    match /announcements/{annId} {
      function kind() { return request.resource.data.get('kind', 'announce'); }
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.by == me().personKey
                    && request.resource.data.createdBy == email()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 300
                    && (
                         (isAdmin() && kind() == 'announce')
                      || (isAdmin() && kind() == 'nudge'
                          && request.resource.data.to is string
                          && request.resource.data.to.size() > 0
                          && request.resource.data.to != me().personKey)
                      || (kind() == 'test' && request.resource.data.to == me().personKey)
                       );
      allow update, delete: if false;
    }

    // What Chạm has done, and how complete the evidence for it is - the
    // roadmap's "what we should track" list. Counts only, never names.
    // Any member may file the after-event review (and nothing else);
    // admins run the rest.
    match /activities/{actId} {
      allow read:   if isMember();
      allow write:  if isAdmin();
      allow update: if isMember()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review', 'reviewedAt'])
                    && request.resource.data.review is map
                    && request.resource.data.review.by == me().personKey;
    }

    // Possible sponsors and where each conversation is up to. Everyone
    // helps chase them; only admins can delete one.
    match /sponsors/{spId} {
      allow read:           if isMember();
      allow create, update: if isMember()
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 80
                            && request.resource.data.stage in ['todo', 'contacted', 'replied', 'meeting', 'agreed', 'no'];
      allow delete:         if isAdmin();
    }

    // Meeting notes. Anyone may take them; only admins delete.
    match /meetings/{mId} {
      allow read:           if isMember();
      allow create, update: if isMember() && request.resource.data.date is string;
      allow delete:         if isAdmin();
    }

    // A sale people can pre-order from. Its name, items, prices and pickup
    // details are public - the order page has to show them to buyers who
    // have no account. Only admins set one up, open it or close it.
    match /sales/{saleId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Pre-orders. Anyone with the link may place one - without an account -
    // but only while the sale is open, only with the fields the form sends,
    // and never already marked paid or picked up. Buyers cannot read any
    // orders back: names and classes are for members only. At the stall any
    // member can tick paid and picked up, and nothing else.
    match /orders/{orderId} {
      function o() { return request.resource.data; }
      allow create: if o().keys().hasOnly(['sale', 'name', 'cls', 'contact', 'items', 'pay', 'note',
                                            'code', 'paid', 'pickedUp', 'pushed', 'createdAt'])
                    && o().sale is string
                    && exists(/databases/$(database)/documents/sales/$(o().sale))
                    && get(/databases/$(database)/documents/sales/$(o().sale)).data.open == true
                    && o().name is string && o().name.size() >= 1 && o().name.size() <= 60
                    && o().get('cls', '') is string && o().get('cls', '').size() <= 20
                    && o().get('contact', '') is string && o().get('contact', '').size() <= 60
                    && o().get('note', '') is string && o().get('note', '').size() <= 200
                    && o().items is map && o().items.size() >= 1 && o().items.size() <= 12
                    && o().pay in ['cash', 'transfer']
                    && o().code is string && o().code.size() <= 8
                    && o().paid == false && o().pickedUp == false && o().pushed == false
                    && o().createdAt == request.time;
      allow read:   if isMember();
      allow update: if isMember()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['paid', 'pickedUp', 'updatedAt', 'updatedBy']);
      allow delete: if isAdmin();
    }

    // The site's base data (team, calendar, the chat feed, links). It used
    // to be a public file; now only members can read it. Uploaded by
    // scripts/publish_data.py with the service account.
    // Who has notifications on, and on what kind of device - worked out by
    // the sender from the subscriptions nobody else may read. Admins only.
    match /meta/{docId} {
      allow read:  if (docId == 'pushStatus' && isAdmin()) || (docId == 'status' && isSysadmin());
      allow write: if false;
    }

    // Events for the countdown card: what's coming, locked or a target, and
    // which jobs belong to it. Everyone sees them; admins set them.
    match /events/{evId} {
      allow read:  if isMember();
      allow write: if isAdmin()
                   && request.resource.data.name is string && request.resource.data.name.size() > 0
                   && request.resource.data.date is string;
      allow delete: if isAdmin();
    }

    // Your own getting-started checklist: yours alone, nobody else's.
    match /onboarding/{who} {
      allow read, write: if isMember() && who == email();
    }

    match /site/{docId} {
      allow read:  if isMember();
      allow write: if false;
    }

    match /tasks/{taskId} {
      allow read:            if isMember();
      allow create, delete:  if isAdmin();

      allow update: if isAdmin()
        || (
             isMember()
             // it must be your own task, and it must stay yours
             && resource.data.who == me().personKey
             && request.resource.data.who == resource.data.who
             // you may only move these fields, nothing else
             && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['status', 'note', 'progress', 'doneAt', 'updatedAt'])
             && request.resource.data.status in ['open', 'doing', 'blocked', 'done']
           );
    }
  }
}
